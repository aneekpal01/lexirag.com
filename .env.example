# ==============================================================================
# LexiRAG SaaS Backend - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Nebius Token Factory (Mandatory - All LLM inference & embeddings route here)
# Base URL must end with trailing slash as per OpenAI client convention
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Models on Nebius Token Factory
# Note: Both models return reasoning traces in `reasoning_content`
NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBEDDING_MODEL=BAAI/bge-m3

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION_NAME=indian_legal_corpus

# Retrieval Parameters
TOP_K_RETRIEVAL_LIMIT=5
MIN_SIMILARITY_SCORE=0.40

# Clerk Authentication
# Set CLERK_DEV_MODE=true for local hackathon testing (bypasses signature check if token='dev-test-token')
CLERK_DEV_MODE=true
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_PEM_PUBLIC_KEY=
